# Copy to the ignored `research.env`, replace the bank path, then source it.
# The AMASS-derived payload and historical checkpoints are intentionally not
# distributed by this repository.

# Either point directly at a bank that passes tools/restore_phase_g_bank.py or
# use that tool to create the ignored bank/amass directory symlink.
export CLIMB_BANK=/absolute/path/to/amass_g1_npz_bank
export CLIMB_CLIPS="$PWD/bank/tiers/tier_800.txt"
export CLIMB_SEGMENT_MANIFEST="$PWD/reports/g_segment/unit_table.json"

# Phase-G G2 profile selected by the endpoint-blind calibration and independent
# validation. Confirmatory training still requires the Phase-G seal and explicit
# approval. Change only the seed across the frozen confirmation seeds 1, 2, 3.
export CLIMB_SEGMENT_SEED=1
export CLIMB_SEGMENT_RANK=learning_progress
export CLIMB_SEGMENT_DIFFICULTY_POWER=0
export CLIMB_SEGMENT_EXPLORATION_RATIO=0.40
export CLIMB_SEGMENT_PROGRESS_WINDOW=10
export CLIMB_SEGMENT_PROGRESS_FLOOR=0.05
export CLIMB_SEGMENT_MAX_UNIT_PROBABILITY=0.05
export CLIMB_SEGMENT_MAX_CLIP_PROBABILITY=0.25
export CLIMB_SEGMENT_FAILURE_PENALTY=-10
export CLIMB_VERIFY_MOTION_HASHES=1

# Frozen confirmation ledger interval. The calibration launcher overrides this
# to 10 and uses its isolated stage seeds.
export CLIMB_SEGMENT_SAVE_INTERVAL=500

# Optional: uncomment and replace only for checkpoint-based historical reruns.
# export CLIMB_CHECKPOINT=/absolute/path/to/model_3999.pt
